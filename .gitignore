# Saída das rodadas (não versionar)
resultados/

# Pastas de trabalho do pipeline por pedido (spec-02+)
trabalho/
finalizados/

# Cache por VÍDEO (spec-05 v3): vídeo + legenda + transcrição do culto, reaproveitados por
# qualquer pedido. Fica fora de trabalho/ de propósito — a limpeza por pedido não o enxerga.
videos/

# Artefatos corrigidos gerados pelo validador
*.corrigido.json

# Segredos — nunca versionar chaves de API
*.key
openrouter.txt
.env
.env.*

# Artefatos soltos de execução/diagnóstico
payload.json
resp.json

# Binários compilados dos comandos Go
/srtclean
/validar
/selecionar
/baixar
/render
cmd/srtclean/srtclean
cmd/validar/validar
cmd/selecionar/selecionar
cmd/baixar/baixar
cmd/render/render

# Mídia bruta/temporária que possa escapar das pastas de trabalho
*.mp4
*.part
*.part-Frag*
invalido_*.txt

# Configuração do Claude Code: .claude/settings.json é VERSIONADO — é contrato do projeto,
# como um CI seria (os hooks rodam build/vet/test ao fim de cada tarefa e gofmt a cada edição).
# O .local.json é pessoal de cada máquina/pessoa e não entra.
.claude/settings.local.json

# Arquivos de sistema/editor
.DS_Store
*.swp
*~
frames-teste/
docs/medicoes/overshoot-parada/v.mp4
